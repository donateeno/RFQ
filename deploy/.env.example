# Copy to deploy/.env on the VPS (never commit the real file).   chmod 600 deploy/.env

# --- public address
APP_DOMAIN=rfq.example.com
APP_BASE_URL=https://rfq.example.com

# --- secrets: generate each with   openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=
INTEGRATION_TOKEN=

# --- Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Workspace domains that may sign in, comma-separated (everyone in them joins as SALES)
ALLOWED_DOMAIN=eve.co.th,siammanor.com

# --- created on first start if missing (later managed in the app → ตั้งค่า)
BOOTSTRAP_ADMINS=akrawat@eve.co.th
BOOTSTRAP_SUPERVISORS=pak.m@eve.co.th
# The ONLY accounts that see cost, gain and exact %MU (supervisors see the MU band). Not editable in the app.
COST_VIEWERS=akrawat@eve.co.th
# Who manages users and permissions in the app (menu เจ้าของระบบ). Leave unset to use COST_VIEWERS.
# OWNERS=akrawat@eve.co.th
# LINE user IDs (comma separated) that also get data-source alerts. Sent by the n8n notify workflow
# (credential 'LINE channel access token' of the company's LINE Official Account).
ALERT_LINE_TO=

# --- n8n webhook that sends the emails (workflow deploy/n8n/rfq-notify.json)
NOTIFY_WEBHOOK_URL=https://n8n.example.com/webhook/rfq-notify
# --- n8n webhook behind the admin "ซิงค์ราคาตอนนี้" button (workflow deploy/n8n/rfq-smg-sync.json)
SYNC_WEBHOOK_URL=https://n8n.example.com/webhook/rfq-smg-sync

# --- reverse proxy: "traefik" (VPS already runs Traefik for n8n) or "caddy"
PROXY=traefik
TRAEFIK_NETWORK=root_default
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge

APP_PORT=3000
TZ=Asia/Bangkok

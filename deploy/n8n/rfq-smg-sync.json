    },
    {
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('Find newest SMG MASTER').item.json.files.find((f) => /^SMG MASTER\\s+\\S/i.test(f.name)).id }}/values:batchGet?ranges=MASTER!A1%3AR&ranges=HOTPRICE!A1%3AG&valueRenderOption=FORMATTED_VALUE",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "4c235417-fd1f-57c2-9ce0-f676ea9e9521",
      "name": "Read MASTER + HOTPRICE",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        100
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Period name from the MASTER file title, e.g. \"SMG MASTER OCT26-JAN27\" → OCT26-JAN27.\n// The period must already exist in the app (ตั้งค่า → รอบราคา → สร้างรอบราคา) or the import is refused (409).\n// Newest file whose title starts with \"SMG MASTER \" (skips \"Copy of SMG MASTER …\").\nconst file = ($('Find newest SMG MASTER').first().json.files || []).find((f) => /^SMG MASTER\\s+\\S/i.test(f.name));\nif (!file) throw new Error('No spreadsheet named \"SMG MASTER <period>\" found');\nconst priceList = file.name.replace(/^SMG MASTER\\s*/i, '').trim();\nconst cost = $('Read cost 2021').first().json.valueRanges;   // '2021'!A3:AQ, relationship!A2:AA (set costs)\nconst master = $('Read MASTER + HOTPRICE').first().json.valueRanges;\nreturn [{ json: { priceList, body: { sheets: {\n  cost: cost[0].values,\n  sets: cost[1].values,   // undefined (left out) when the tab is empty\n  pricelist: $('Read Nationwide pricelist').first().json.values,\n  master: master[0].values,\n  hot: master[1].values\n} } } }];"
      },
      "id": "c7a12680-6a8e-5611-af52-52b12bead934",
      "name": "Combine sheets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://rfq.example.com/api/integrations/import/smg_catalog?priceList={{ encodeURIComponent($json.priceList) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "47ca06cd-5279-540a-975d-999aa9dabfbd",
      "name": "Import into RFQ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "RFQ integration token"
        }
      }
    },
    {
      "parameters": {
        "url": "https://sheets.googleapis.com/v4/spreadsheets/PUT_MAPPING_FILE_ID_HERE/values:batchGet?ranges=%27Term%20Library%27%21A1%3AK&ranges=%27Customer%20Groups%27%21A1%3AH&ranges=%27Group%20Terms%27%21A1%3AK&ranges=%27Channel%20Map%27%21A1%3AB&ranges=%27Customer%20Map%27%21A1%3AD&ranges=%27Active%20Customers%27%21A6%3AH&valueRenderOption=FORMATTED_VALUE",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "f0d38c18-b49e-5703-b0f1-8e606b0515f2",
      "name": "Read Customer Price Mapping",

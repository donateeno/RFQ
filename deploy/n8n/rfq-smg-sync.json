{
  "name": "RFQ – sync SMG catalogue (cost, Nationwide pricelist, SMG MASTER)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 6,
              "triggerAtMinute": 15
            }
          ]
        }
      },
      "id": "6236c1a2-eb27-59cf-a1e2-e5c6d2d6d467",
      "name": "Daily 06:15",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rfq-smg-sync",
        "authentication": "headerAuth",

    {
      "parameters": {
        "jsCode": "// Tabs of the Customer Price Mapping Template, in the order requested above.\nconst v = $json.valueRanges.map((r) => r.values || []);\nreturn [{ json: { sheets: { terms: v[0], groups: v[1], groupTerms: v[2], channels: v[3], customerMap: v[4], customers: v[5] } } }];"
      },
      "id": "9a8732e1-5292-5e36-91fd-474f9a0645c5",

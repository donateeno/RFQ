    {
      "parameters": {
        "jsCode": "// Period name from the MASTER file title, e.g. \"SMG MASTER OCT26-JAN27\" → OCT26-JAN27.\n// The period must already exist in the app (ตั้งค่า → รอบราคา → สร้างรอบราคา) or the import is refused (409).\n// Newest file whose title starts with \"SMG MASTER \" (skips \"Copy of SMG MASTER …\").\nconst file = ($('Find newest SMG MASTER').first().json.files || []).find((f) => /^SMG MASTER\\s+\\S/i.test(f.name));\nif (!file) throw new Error('No spreadsheet named \"SMG MASTER <period>\" found');\nconst priceList = file.name.replace(/^SMG MASTER\\s*/i, '').trim();\n// Optional tabs (set costs, NON PC wholesale): a missing or renamed tab does not stop the sync;\n// the app lists it under เจ้าของระบบ › แหล่งข้อมูล and alerts the owner (email + LINE).\n// Only \"tab not found\" (Google: \"Unable to parse range\") counts as missing; any other error (quota, outage)\n// stops the sync so the period's set costs and wholesale prices are not cleared by a passing failure.\nconst optional = (node) => {\n  const j = $(node).first().json;\n  if (j && j.valueRanges) return j.valueRanges[0].values || [];\n  const err = JSON.stringify((j && j.error) || j || {});\n  if (/Unable to parse range/i.test(err)) return undefined;\n  throw new Error(node + ' failed: ' + err.slice(0, 300));\n};\nconst cost = $('Read cost 2021').first().json;              // '2021'!A3:AQ\nconst nationwide = $('Read Nationwide pricelist').first().json;\nconst master = $('Read MASTER + HOTPRICE').first().json.valueRanges;\nconst sets = optional('Read set costs');                     // relationship!A2:AA\nconst wholesale = optional('Read WHOLESALE');                // WHOLESALE!A1:M\nconst missing = [];\nif (sets === undefined) missing.push('sets');\nif (wholesale === undefined) missing.push('wholesale');\nreturn [{ json: { priceList, body: {\n  sheets: { cost: cost.valueRanges[0].values, sets, wholesale, pricelist: nationwide.valueRanges[0].values, master: master[0].values, hot: master[1].values },\n  // spreadsheet IDs: links on the app's data sources page\n  files: { cost: cost.spreadsheetId, nationwide: nationwide.spreadsheetId, master: { id: file.id, name: file.name } },\n  missing\n} } }];"
      },
      "id": "c7a12680-6a8e-5611-af52-52b12bead934",
      "name": "Combine sheets",

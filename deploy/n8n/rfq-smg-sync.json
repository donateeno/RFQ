      "id": "4c235417-fd1f-57c2-9ce0-f676ea9e9521",
      "name": "Read MASTER + HOTPRICE",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        100
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE",
          "name": "Google Sheets account"
        }

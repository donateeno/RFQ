      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('Find newest SMG MASTER').item.json.files.find((f) => /^SMG MASTER\\s+\\S/i.test(f.name)).id }}/values:batchGet?ranges=MASTER!A1%3AY&ranges=HOTPRICE!A1%3AG&valueRenderOption=FORMATTED_VALUE",
